{
  "name": "from-js-import-python",
  "private": true,
  "version": "0.1.0",
  "description": "Learn Python through the lens of JavaScript: side-by-side idiom mappings, Pythonic upgrades, and in-browser coding challenges powered by Pyodide.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "validate": "node --disable-warning=ExperimentalWarning scripts/validate.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run validate"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "markdown-it": "^15.0.3",
    "pyodide": "314.0.7",
    "shiki": "^4.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
